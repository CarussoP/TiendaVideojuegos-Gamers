<?xml version="1.0" encoding="UTF-8"?>
<hibernate-mapping package="mx.com.cursodia.javaEE2022.Beans">
	<class name="Videojuego" table="videojuego">
		<id name="vj_id" type="int" column="vj_id">
			<generator class="native" />
		</id>
		<!-- lazy=false: los JSP leen catalogo/proveedor fuera de la Session -->
		<many-to-one name="videojuegoCatalogo" class="VideojuegoCatalogo" column="vj_cat_vid_id" not-null="true" lazy="false" />
		<many-to-one name="proveedor" class="Proveedor" column="vj_cat_prov_id" not-null="true" lazy="false" />
		<property name="vj_precio_compra" type="float" column="vj_precio_compra" />
		<property name="vj_precio_venta" type="float" column="vj_precio_venta" />
		<property name="vj_cantidad" type="int" column="vj_cantidad" />
	</class>
</hibernate-mapping>
