<?xml version="1.0" encoding="UTF-8"?>
<hibernate-mapping package="mx.com.cursodia.javaEE2022.Beans">
	<class name="VideojuegoCatalogo" table="cat_videojuegos">
		<id name="cat_vid_id" type="int" column="cat_vid_id">
			<generator class="native" />
		</id>
		<property name="cat_vid_nombre" type="string" column="cat_vid_nombre" />
		<many-to-one name="plataforma" class="Plataforma" column="cat_vid_pla_id" />
		<property name="cat_vid_inventario" type="int" column="cat_vid_inventario" />
	</class>
</hibernate-mapping>
